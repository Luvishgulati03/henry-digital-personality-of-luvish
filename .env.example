# Henry runtime
HENRY_PORT=7337
HENRY_HOST=127.0.0.1
HENRY_ALLOW_REMOTE_DASHBOARD=false
HENRY_DASHBOARD_TOKEN=
HENRY_PROVIDER=codex
HENRY_CODEX_MODEL=
HENRY_CLAUDE_MODEL=

# The app-level outbound gate remains enabled even though Codex runs without prompts.
HENRY_REQUIRE_OUTBOUND_APPROVAL=true

# Job applications. The profile and resume are personal files kept out of Git.
# Legacy LAVU_* variable names are still honoured as a fallback.
HENRY_JOB_PROFILE_PATH=application-profile.md
HENRY_RESUME_SOURCE_PATH=resume.md
HENRY_BROWSER_PROFILE_DIR=data/browser-profile
HENRY_BROWSER_HEADLESS=false

# Optional: used to recognise your own address. All outbound actions are still
# approval-gated by default. (The legacy DAD_EMAIL spelling is still honoured.)
HENRY_OWNER_EMAIL=

# Gmail OAuth desktop-app credentials downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_PATH=./data/gmail-credentials.json
GMAIL_TOKEN_PATH=./data/gmail-token.json
GMAIL_REDIRECT_URI=http://127.0.0.1:43821/oauth2callback

# Optional GitHub configuration. Henry also respects the gh CLI login.
GH_HOST=github.com

# Optional semantic embeddings. Engram works offline with hashing embeddings.
OPENAI_API_KEY=

# Optional: Telegram operator-notification channel (docs/modules/telegram.md).
# Reminders/mail-watch alerts still deliver via console + macOS notification
# when these are blank; Telegram is a fire-and-forget extra leg.
HENRY_TELEGRAM_BOT_TOKEN=
HENRY_TELEGRAM_CHAT_ID=

# Team standup group (optional): the ONLY chat the standup poller reads.
# Find it after adding the bot to your group: henry standup discover
HENRY_TELEGRAM_STANDUP_CHAT_ID=

# --- Daily tech tweet (X API v2, user-context OAuth 1.0a) ---
# All four required together (partial sets are treated as no keys — tweets stage
# instead of posting). Create a Read+Write app at developer.x.com.
# Kill switch lives in settings: `henry tweet on|off`.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Job scout (morning Naukri + web + X shortlist) ---
# Titles searched daily; `henry jobs alerts-sync` learns these from your job-alert
# emails instead and takes precedence when a profile exists. Empty = the scout skips
# until you set titles here or run alerts-sync.
# e.g. Product Manager, Software Engineer
HENRY_JOB_SCOUT_TITLES=
# e.g. Remote (the default when blank), Berlin, Bengaluru
HENRY_JOB_SCOUT_LOCATION=

# --- Portfolio (optional): a SEPARATE GitHub Pages repo Henry may edit and stat-refresh ---
# All three are OPTIONAL and nothing is baked in. With HENRY_PORTFOLIO_DIR unset, the agent
# prompt carries no portfolio instructions and the daily portfolio.stats workflow skips with
# a reason. HENRY_GITHUB_LOGIN is the account whose contribution graph that refresh reads —
# unset and the workflow skips rather than querying anyone's account.
# HENRY_PORTFOLIO_DIR=~/dev/portfolio
# HENRY_PORTFOLIO_SITE=https://<your-github-username>.github.io   # display only, never fetched
# HENRY_GITHUB_LOGIN=<your-github-username>

# --- Optional paths & toggles (defaults are sensible; uncomment to override) ---
# HENRY_DATA_DIR=data
# HENRY_MEMORY_DIR=memory
# HENRY_KNOWLEDGE_DIR=knowledge
# HENRY_WORKFLOWS_PATH=workflows/defaults.json
# HENRY_WORKFLOWS_DIR=workflows
# HENRY_NO_DASHBOARD=1
# HENRY_WHISPER_MODEL=/path/to/ggml-model.bin   # required for meeting shadow
# HENRY_SCREENSHOTS_DIR=~/Desktop
# HENRY_SCREENSHOTS_SORTED_DIR=~/Pictures/sorted-screenshots
# HENRY_SCREENSHOT_CATEGORIES=work,design-reference,receipts,memes,documents,code,_unsorted
